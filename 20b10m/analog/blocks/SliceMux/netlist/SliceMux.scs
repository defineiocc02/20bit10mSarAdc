// ============================================================
// [CODE-INDEX] SliceMux.scs —— 18:1 顶板选通（8 片同时导通）
// 端口：VTOPP/N<17:0>（池顶板）、SEL/SELB<17:0>（8 个高）、VOUTP/N（到 RA）
// 指标：Ron ≤20 Ω/片；片间偏斜 ≤50 ps；总线寄生 ≤0.5 pF；先断后合
// 说明：SEL 由 SliceSched 的 conv 组给出；SELB 为反相，避免模拟侧加反相器。
// ============================================================
// SliceMux.scs —— 18:1 顶板选通（8 片同时导通，汇到 RA 输入）
// 端口：VTOPP<17:0> VTOPN<17:0> SEL<17:0> SELB<17:0> VOUTP VOUTN VDD5 GND
// 指标：Ron ≤20 Ω/片；片间偏斜 ≤50 ps；总线寄生 ≤0.5 pF；先断后合
simulator lang=spectre

subckt SliceMux VTOPP<17:0> VTOPN<17:0> SEL<17:0> SELB<17:0> VOUTP VOUTN VDD5 GND
Xmp0 (VTOPP<0> VOUTP SEL<0> SELB<0> VDD5 GND) tg5 wn=40u wp=80u
Xmn0 (VTOPN<0> VOUTN SEL<0> SELB<0> VDD5 GND) tg5 wn=40u wp=80u
Xmp1 (VTOPP<1> VOUTP SEL<1> SELB<1> VDD5 GND) tg5 wn=40u wp=80u
Xmn1 (VTOPN<1> VOUTN SEL<1> SELB<1> VDD5 GND) tg5 wn=40u wp=80u
Xmp2 (VTOPP<2> VOUTP SEL<2> SELB<2> VDD5 GND) tg5 wn=40u wp=80u
Xmn2 (VTOPN<2> VOUTN SEL<2> SELB<2> VDD5 GND) tg5 wn=40u wp=80u
Xmp3 (VTOPP<3> VOUTP SEL<3> SELB<3> VDD5 GND) tg5 wn=40u wp=80u
Xmn3 (VTOPN<3> VOUTN SEL<3> SELB<3> VDD5 GND) tg5 wn=40u wp=80u
